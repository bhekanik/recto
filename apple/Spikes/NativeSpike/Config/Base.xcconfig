// Shared settings for the N0a spike. Environment values (Clerk publishable key,
// Convex deployment URL) are NOT in this file and are never committed: they live
// in Config/Local.xcconfig, which is gitignored and generated by
// scripts/write-local-config.sh.
//
// xcconfig treats "//" as a comment even in the middle of a value, so a URL
// literal truncates to "https:". Build the separator from a single-slash
// variable instead (the life-coach-os gotcha).
RECTO_SLASH = /

// Fallbacks so a clean clone still compiles; the app fails loudly at launch.
RECTO_CLERK_PUBLISHABLE_KEY = MISSING_CLERK_PUBLISHABLE_KEY
RECTO_CONVEX_DEPLOYMENT_URL = MISSING_CONVEX_DEPLOYMENT_URL

#include? "Local.xcconfig"
