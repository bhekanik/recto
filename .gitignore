# JS bundles (plan 023) — built by `bun run core:build` / `vim:build`, never
# committed. `dist` above already covers both packages' dist directories; the
# manifests carry the sha256 the Xcode copy step checks.
packages/recto-core-js/manifest.json
packages/recto-vim-js/manifest.json
# `apple/scripts/copy-js-bundles.sh` installs the same bundles here. Committing
# them would put a 1 MB unreadable diff in every `lib/` change and let the copy
# drift from the source it was built from.
apple/Packages/RectoCoreJS/Sources/RectoCoreJS/JS/*.js
apple/Packages/RectoVim/Sources/RectoVim/JS/*.js
# Same bundle again, staged for the device perf spike. It was committed once and
# was immediately stale — the version string carries the git sha, so a committed
# copy names a commit that is no longer HEAD and a device run would measure it.
apple/Spikes/JSCPerf/Tests/JSCPerfTests/JS/*.js
.build
.swiftpm

