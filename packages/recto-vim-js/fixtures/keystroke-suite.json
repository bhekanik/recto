{
	"about": "Vim behaviour the native client must reproduce. Expectations are written from vim semantics, not captured from the implementation. Both the Bun suite (test/suite.test.ts) and the Swift suite (apple/Spikes/VimSpike) run this same file, so a divergence between them is a bridge bug rather than a vim bug. cursor is [line, ch] with ch in UTF-16 code units.",
	"cases": [
		{
			"name": "dw at start of line",
			"text": "the quick brown fox",
			"cursor": [0, 0],
			"keys": "dw",
			"expectText": "quick brown fox",
			"expectCursor": [0, 0]
		},
		{
			"name": "dw mid-line",
			"text": "the quick brown fox",
			"cursor": [0, 4],
			"keys": "dw",
			"expectText": "the brown fox"
		},
		{
			"name": "de leaves the trailing space",
			"text": "the quick brown fox",
			"cursor": [0, 4],
			"keys": "de",
			"expectText": "the  brown fox"
		},
		{
			"name": "daw takes the trailing space",
			"text": "the quick brown fox",
			"cursor": [0, 4],
			"keys": "daw",
			"expectText": "the brown fox"
		},
		{
			"name": "diw keeps surrounding spaces",
			"text": "the quick brown fox",
			"cursor": [0, 4],
			"keys": "diw",
			"expectText": "the  brown fox"
		},
		{
			"name": "ciw replaces the word",
			"text": "the quick brown fox",
			"cursor": [0, 4],
			"keys": "ciwslow<Esc>",
			"expectText": "the slow brown fox",
			"expectMode": "normal"
		},
		{
			"name": "ciw leaves insert mode open before Esc",
			"text": "the quick brown fox",
			"cursor": [0, 4],
			"keys": "ciw",
			"expectText": "the  brown fox",
			"expectMode": "insert"
		},
		{
			"name": "caw replaces word and space",
			"text": "the quick brown fox",
			"cursor": [0, 4],
			"keys": "cawfast <Esc>",
			"expectText": "the fast brown fox"
		},
		{
			"name": "cw behaves like ce",
			"text": "the quick brown fox",
			"cursor": [0, 4],
			"keys": "cwslow<Esc>",
			"expectText": "the slow brown fox"
		},
		{
			"name": "x deletes one character",
			"text": "the quick brown fox",
			"cursor": [0, 0],
			"keys": "x",
			"expectText": "he quick brown fox"
		},
		{
			"name": "3x deletes three characters",
			"text": "the quick brown fox",
			"cursor": [0, 0],
			"keys": "3x",
			"expectText": " quick brown fox"
		},
		{
			"name": "D deletes to end of line",
			"text": "the quick brown fox",
			"cursor": [0, 4],
			"keys": "D",
			"expectText": "the "
		},
		{
			"name": "C changes to end of line",
			"text": "the quick brown fox",
			"cursor": [0, 4],
			"keys": "Cnew<Esc>",
			"expectText": "the new"
		},
		{
			"name": "dd removes the current line",
			"text": "alpha\nbeta\ngamma",
			"cursor": [1, 0],
			"keys": "dd",
			"expectText": "alpha\ngamma"
		},
		{
			"name": "3dd removes three lines",
			"text": "one\ntwo\nthree\nfour\nfive",
			"cursor": [1, 0],
			"keys": "3dd",
			"expectText": "one\nfive"
		},
		{
			"name": "yy then p duplicates the line below",
			"text": "one\ntwo",
			"cursor": [0, 0],
			"keys": "yyp",
			"expectText": "one\none\ntwo"
		},
		{
			"name": "yw then P pastes before the caret",
			"text": "abcdef",
			"cursor": [0, 0],
			"keys": "vllyP",
			"expectText": "abcabcdef"
		},
		{
			"name": "J joins two lines with a space",
			"text": "line one\nline two",
			"cursor": [0, 0],
			"keys": "J",
			"expectText": "line one line two"
		},
		{
			"name": "o opens a line below",
			"text": "abc",
			"cursor": [0, 0],
			"keys": "onew<Esc>",
			"expectText": "abc\nnew"
		},
		{
			"name": "O opens a line above",
			"text": "abc",
			"cursor": [0, 0],
			"keys": "Onew<Esc>",
			"expectText": "new\nabc"
		},
		{
			"name": "A appends at end of line",
