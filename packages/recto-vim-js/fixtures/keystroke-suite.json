			"expectText": "keep\nkeep2"
		},
		{
			"name": "ci( changes inside parens",
			"text": "foo(bar)baz",
			"cursor": [0, 5],
			"keys": "ci(new<Esc>",
			"expectText": "foo(new)baz"
		},
		{
			"name": "di\" deletes inside quotes",
			"text": "say \"hello\" now",
			"cursor": [0, 6],
			"keys": "di\"",
			"expectText": "say \"\" now"
		},
		{
			"name": "mark and jump back",
			"text": "line1\nline2\nline3",
			"cursor": [0, 0],
			"keys": "majj`ax",
			"expectText": "ine1\nline2\nline3"
		},
		{
			"name": "record and replay a macro",
			"text": "aaa\nbbb\nccc",
			"cursor": [0, 0],
			"keys": "qqxjq@q",
			"expectText": "aa\nbb\nccc"
		},
		{
			"name": "ctrl-a increments a number",
			"text": "value 41",
			"cursor": [0, 0],
			"keys": "<C-a>",
			"expectText": "value 42"
		},
		{
			"name": "P pastes a yanked line above",
