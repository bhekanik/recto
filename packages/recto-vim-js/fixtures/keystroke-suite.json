			"cursor": [0, 0],
			"keys": "dwu",
			"expectText": "one two three"
		},
		{
			"name": "ctrl-r redoes through the host",
			"text": "one two three",
			"cursor": [0, 0],
			"keys": "dwu<C-r>",
			"expectText": "two three"
		},
		{
			"name": "ex substitute on the current line",
			"text": "the quick brown fox",
			"cursor": [0, 0],
			"keys": ":s/quick/slow/<CR>",
