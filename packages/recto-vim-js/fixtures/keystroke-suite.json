			"expectText": "alpha eta gamma\ndelta beta zeta"
		},
		{
			"name": "count with a word motion",
			"text": "one two three four",
			"cursor": [0, 0],
			"keys": "2wx",
			"expectText": "one two hree four"
		},
		{
			"name": "dot repeats the last change",
			"text": "one two three four",
			"cursor": [0, 0],
			"keys": "dw.",
			"expectText": "three four"
		},
		{
			"name": "dot repeats an insert",
			"text": "ab",
			"cursor": [0, 0],
			"keys": "ix<Esc>.",
			"expectText": "xxab"
		},
		{
			"name": "u undoes through the host",
