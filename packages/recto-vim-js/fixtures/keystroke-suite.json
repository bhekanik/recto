			"expectText": "abc!"
		},
		{
			"name": "I inserts at start of line",
			"text": "abc",
			"cursor": [0, 2],
			"keys": "Ix<Esc>",
			"expectText": "xabc"
		},
		{
			"name": "r replaces one character",
			"text": "abc",
			"cursor": [0, 0],
			"keys": "rz",
			"expectText": "zbc",
			"expectMode": "normal"
		},
		{
			"name": "R overwrites in replace mode",
			"text": "abcdef",
			"cursor": [0, 0],
			"keys": "RXY<Esc>",
			"expectText": "XYcdef"
		},
		{
			"name": "~ toggles case and advances",
			"text": "abc",
			"cursor": [0, 0],
			"keys": "~",
			"expectText": "Abc",
			"expectCursor": [0, 1]
		},
		{
			"name": "gg jumps to the first line",
			"text": "aaa\nbbb\nccc",
			"cursor": [2, 0],
			"keys": "ggx",
			"expectText": "aa\nbbb\nccc"
		},
		{
			"name": "G jumps to the last line",
			"text": "aaa\nbbb\nccc",
			"cursor": [0, 0],
			"keys": "Gx",
			"expectText": "aaa\nbbb\ncc"
		},
		{
			"name": "dG deletes to end of buffer",
			"text": "aaa\nbbb\nccc",
			"cursor": [1, 0],
			"keys": "dG",
			"expectText": "aaa\n",
			"note": "Real vim leaves a 1-line buffer; codemirror-vim asks to delete {line:1,ch:0}..{line:3,ch:0} and the out-of-range line clamps to end-of-document, so the newline after line 0 survives. The web lens does the same today — this fixture tracks the web, not vim."
		},
		{
			"name": "dgg deletes to start of buffer",
			"text": "aaa\nbbb\nccc",
			"cursor": [1, 0],
			"keys": "dgg",
			"expectText": "ccc"
		},
		{
			"name": "$ moves to end of line",
			"text": "abcd",
			"cursor": [0, 0],
			"keys": "$x",
			"expectText": "abc"
		},
		{
			"name": "0 moves to column zero",
			"text": "abcd",
			"cursor": [0, 3],
			"keys": "0x",
			"expectText": "bcd"
		},
		{
			"name": "^ moves to first non-blank",
			"text": "  abcd",
			"cursor": [0, 5],
			"keys": "^x",
			"expectText": "  bcd"
		},
		{
			"name": "f jumps onto the character",
			"text": "abcabc",
			"cursor": [0, 0],
			"keys": "fcx",
			"expectText": "ababc"
		},
		{
			"name": "t stops before the character",
			"text": "abcabc",
			"cursor": [0, 0],
			"keys": "tcx",
			"expectText": "acabc"
		},
		{
			"name": "; repeats the last f",
			"text": "abcabc",
			"cursor": [0, 0],
			"keys": "fc;x",
			"expectText": "abcab"
		},
		{
			"name": "v with motions then d",
			"text": "abcdef",
			"cursor": [0, 0],
			"keys": "vlld",
			"expectText": "def",
			"expectMode": "normal"
		},
		{
			"name": "v enters visual mode",
			"text": "abcdef",
			"cursor": [0, 0],
			"keys": "v",
			"expectText": "abcdef",
			"expectMode": "visual"
		},
		{
			"name": "V deletes the whole line",
			"text": "aaa\nbbb\nccc",
			"cursor": [1, 0],
			"keys": "Vd",
			"expectText": "aaa\nccc"
		},
		{
			"name": "viw selects the inner word",
			"text": "the quick brown",
			"cursor": [0, 4],
			"keys": "viwd",
			"expectText": "the  brown"
		},
		{
			"name": "search moves to the first match",
			"text": "alpha beta gamma\ndelta beta zeta",
			"cursor": [0, 0],
			"keys": "/beta<CR>x",
			"expectText": "alpha eta gamma\ndelta beta zeta"
		},
